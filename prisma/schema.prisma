datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Roles: SUPER_ADMIN, ADMIN, GESTOR, SOPORTE, READ_ONLY
model AdminUser {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  role             String         @default("ADMIN")
  twoFactorSecret  String?
  twoFactorEnabled Boolean        @default(false)
  recoveryCodes    String?        // Guardados encriptados/hasheados o separados por comas
  passwordChangedAt DateTime      @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         AdminSession[]
  auditLogs        AuditLog[]
}

model AdminSession {
  id          String    @id @default(uuid())
  userId      String
  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  deviceType  String?   // Mobile, Desktop, Tablet, etc.
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
}

model AuditLog {
  id        String     @id @default(uuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String     // E.g., "LOGIN_SUCCESS", "PRODUCT_EDIT", "EMERGENCY_SHUTDOWN"
  details   String?    // JSON o texto con detalles adicionales
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())
}

model SystemHealth {
  id           String   @id @default(uuid())
  serviceName  String   @unique // "paypal", "printful", "database", "smtp"
  status       String   // "online", "offline", "degraded"
  responseTime Int      // En milisegundos
  lastChecked  DateTime @default(now())
}

model Order {
  id              String       @id // ID interno local (UUID o localId)
  orderNumber     String       @unique // Legible order number like AA-10001
  email           String
  name            String
  phone           String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String?      // Provincia
  postalCode      String
  country         String
  orderStatus     String       @default("draft") // draft, paid, fulfillment_submitted, fulfillment_failed, shipped, canceled
  paymentStatus   String       @default("pago_pendiente") // pago_pendiente, pagado, fallido, reembolsado
  paymentMethod   String       @default("paypal")
  subtotal        Float
  shipping        Float        @default(0.0)
  tax             Float        @default(0.0)
  discount        Float        @default(0.0)
  total           Float
  currency        String       @default("EUR")
  totalCost       Float        @default(0.0) // Production cost sum
  shippingCost    Float        @default(0.0) // Shipping cost charged by Printful
  netProfit       Float        @default(0.0) // Benefit (total - totalCost)
  paypalOrderId   String?      @unique
  paypalCaptureId String?
  printfulOrderId Int?
  trackingNumber  String?
  trackingUrl     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
  events          OrderEvent[]
  emailLogs       EmailLog[]
  internalNotes   String?
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String  // Local product ID (e.g. p1, p3)
  name              String
  size              String
  color             String
  sku               String?
  printfulProductId Int?
  printfulVariantId Int?
  quantity          Int
  price             Float   // Unit price (retail paid by customer)
  total             Float   // Line total (price * quantity)
  costPrice         Float   @default(0.0) // Unit production cost
  mockupUrl         String?
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // E.g., "CREATED", "PAYMENT_PENDING", "PAID", "FULFILLMENT_SUBMITTED", etc.
  message   String   // Legible description in Spanish
  createdAt DateTime @default(now())
}

model EmailLog {
  id           String   @id @default(uuid())
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  emailType    String   // RECEIVED, PAYMENT_CONFIRMED, PRODUCTION, SHIPPED, DELIVERED, REFUNDED, DISPUTE, CANCELED
  recipient    String
  subject      String
  status       String   // "success", "failed"
  errorMessage String?
  sentAt       DateTime @default(now())
}

