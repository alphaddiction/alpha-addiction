datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Roles: SUPER_ADMIN, ADMIN, GESTOR, SOPORTE, READ_ONLY
model AdminUser {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  role             String         @default("ADMIN")
  twoFactorSecret          String?
  twoFactorEnabled         Boolean        @default(false)
  recoveryCodes            String?        // Guardados encriptados/hasheados o separados por comas
  twoFactorSecretEncrypted String?
  twoFactorConfirmedAt     DateTime?
  twoFactorLastUsedAt      DateTime?
  recoveryCodesHash        String?
  lastSecurityEventAt      DateTime?
  passwordChangedAt        DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         AdminSession[]
  auditLogs        AuditLog[]
}

model AdminSession {
  id          String    @id @default(uuid())
  userId      String
  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  deviceType  String?   // Mobile, Desktop, Tablet, etc.
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
}

model AuditLog {
  id        String     @id @default(uuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String     // E.g., "LOGIN_SUCCESS", "PRODUCT_EDIT", "EMERGENCY_SHUTDOWN"
  details   String?    // JSON o texto con detalles adicionales
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())
}

model SystemHealth {
  id           String   @id @default(uuid())
  serviceName  String   @unique // "paypal", "printful", "database", "smtp"
  status       String   // "online", "offline", "degraded"
  responseTime Int      // En milisegundos
  lastChecked  DateTime @default(now())
}

model Order {
  id              String       @id // ID interno local (UUID o localId)
  orderNumber     String       @unique // Legible order number like AA-10001
  email           String
  name            String
  phone           String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String?      // Provincia
  postalCode      String
  country         String
  orderStatus     String       @default("draft") // draft, paid, fulfillment_submitted, fulfillment_failed, shipped, canceled
  paymentStatus   String       @default("pago_pendiente") // pago_pendiente, pagado, fallido, reembolsado
  paymentMethod   String       @default("paypal")
  subtotal        Float
  shipping        Float        @default(0.0)
  tax             Float        @default(0.0)
  discount        Float        @default(0.0)
  total           Float
  currency        String       @default("EUR")
  totalCost       Float        @default(0.0) // Production cost sum
  shippingCost    Float        @default(0.0) // Shipping cost charged by Printful
  netProfit       Float        @default(0.0) // Benefit (total - totalCost)
  paypalOrderId   String?      @unique
  paypalCaptureId String?
  printfulOrderId Int?
  trackingNumber  String?
  trackingUrl     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
  events          OrderEvent[]
  emailLogs       EmailLog[]
  internalNotes   String?
  discountId      String?
  discountRel     Discount?    @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountCode    String?
  redemptions     DiscountRedemption[]
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String  // Local product ID (e.g. p1, p3)
  name              String
  size              String
  color             String
  sku               String?
  printfulProductId Int?
  printfulVariantId Int?
  quantity          Int
  price             Float   // Unit price (retail paid by customer)
  total             Float   // Line total (price * quantity)
  costPrice         Float   @default(0.0) // Unit production cost
  mockupUrl         String?
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // E.g., "CREATED", "PAYMENT_PENDING", "PAID", "FULFILLMENT_SUBMITTED", etc.
  message   String   // Legible description in Spanish
  createdAt DateTime @default(now())
}

model EmailLog {
  id           String   @id @default(uuid())
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  emailType    String   // RECEIVED, PAYMENT_CONFIRMED, PRODUCTION, SHIPPED, DELIVERED, REFUNDED, DISPUTE, CANCELED
  recipient    String
  subject      String
  status       String   // "success", "failed"
  errorMessage String?
  sentAt       DateTime @default(now())
}

model Drop {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  description     String
  mainImage       String
  banner          String
  videoUrl        String?
  status          String         @default("DRAFT") // DRAFT, COMING_SOON, LIVE, SOLD_OUT, ENDED, ARCHIVED
  openingAt       DateTime
  closingAt       DateTime
  publishedAt     DateTime?
  primaryColor    String         @default("#d4af37")
  order           Int            @default(0)
  metaTitle       String?
  metaDescription String?
  visible         Boolean        @default(true)
  featured        Boolean        @default(false)
  products        Product[]
  waitlist        DropWaitlist[]
  discounts       Discount[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Product {
  id                String   @id // local ID (e.g. p1, p3)
  slug              String   @unique
  name              String
  priceEUR          Float
  category          String
  descriptionShort  String
  status            String   // 'in_stock', 'sold_out'
  images            Json     // ProductImage[]
  printfulProductId Int?
  colors            Json?    // string[]
  sizes             Json?    // string[]
  colorVariants     Json?    // ColorVariant[] (contiene mockup y sizes con virtualStock)
  dropId            String?
  drop              Drop?    @relation(fields: [dropId], references: [id], onDelete: SetNull)
  discounts         Discount[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DropWaitlist {
  id            String    @id @default(uuid())
  dropId        String
  drop          Drop      @relation(fields: [dropId], references: [id], onDelete: Cascade)
  email         String
  name          String?
  origin        String?   @default("web")
  status        String    @default("registered") // registered, confirmed, notified, pending
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?
  ipHash        String?
  userAgentHash String?

  @@unique([dropId, email])
}

model Discount {
  id                 String               @id @default(uuid())
  code               String               @unique // Guardar siempre en mayúsculas
  type               String               // PERCENTAGE, FIXED_AMOUNT, FREE_SHIPPING
  value              Float
  status             String               @default("ACTIVE") // ACTIVE, INACTIVE
  maxUses            Int?                 // null significa ilimitado
  usedCount          Int                  @default(0)
  startsAt           DateTime
  endsAt             DateTime
  dropId             String?              // Restringido opcionalmente a un Drop
  drop               Drop?                @relation(fields: [dropId], references: [id], onDelete: SetNull)
  productId          String?              // Restringido opcionalmente a un Producto
  product            Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerEmail      String?              // Restringido opcionalmente a un Email
  minimumOrderAmount Float                @default(0.0)
  isWaitlistOnly     Boolean              @default(false) // Si es exclusivo para registrados de la waitlist
  showInPromoBar     Boolean              @default(false) // Si se muestra automáticamente en la barra superior
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  redemptions        DiscountRedemption[]
  orders             Order[]
}

model DiscountRedemption {
  id         String   @id @default(uuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ipHash     String?
  createdAt  DateTime @default(now())
}

model Announcement {
  id                 String    @id @default(uuid())
  type               String    @default("MANUAL") // MANUAL, AUTOMATIC
  category           String    @default("PROMOTION") // PROMOTION, SYSTEM, ALERT, COUNTDOWN
  title              String
  text               String
  icon               String?
  url                String?
  openInNewTab       Boolean   @default(false)
  priority           Int       @default(0)
  order              Int       @default(0)
  displayMode        String    @default("CONTINUOUS") // CONTINUOUS, ROTATE, CAROUSEL
  active             Boolean   @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  config             Json?     // Custom CSS/styling options (e.g. colors, speed, height)
  autoConditions     Json?     // Automatic trigger conditions (e.g. low stock, drop countdown)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AutomationLog {
  id           String   @id @default(uuid())
  eventType    String
  status       String   // SUCCESS, FAILED
  message      String?
  durationMs   Int
  error        String?
  createdAt    DateTime @default(now())
}

model SupportTicket {
  id            String           @id @default(uuid())
  ticketNumber  String           @unique // Legible format like TK-10001
  customerEmail String
  customerName  String
  orderId       String?
  orderNumber   String?
  category      String
  subject       String
  status        String           @default("open") // open, pending, replied, resolved, closed
  priority      String           @default("normal") // low, normal, high, urgent
  source        String           @default("web") // web, email, etc.
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  closedAt      DateTime?
  messages      SupportMessage[]
}

model SupportMessage {
  id           String        @id @default(uuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType   String        // "customer" o "agent"
  senderEmail  String
  body         String
  createdAt    DateTime      @default(now())
  internalNote Boolean       @default(false)
  attachments  Json?         // Preparado para metadatos de adjuntos
  messageId    String?       // ID único de mensaje RFC 2822
  inReplyTo    String?       // ID de mensaje al que responde
  references   String?       // IDs de mensajes relacionados
  htmlBody     String?       // Cuerpo del correo en formato HTML
}

model SupportOtp {
  id        String   @id @default(uuid())
  email     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  ipAddress String
  createdAt DateTime @default(now())
}

model CustomerAccessLog {
  id              String   @id @default(uuid())
  email           String
  orderNumber     String?
  accessType      String   // "OTP", "TOKEN", "CREDENTIALS"
  durationSeconds Int?     // Duración de la auth OTP en segundos
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
}

model ActiveToken {
  id          String   @id @default(uuid())
  token       String   @unique
  email       String
  orderNumber String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model CustomerConsent {
  id               String   @id @default(uuid())
  email            String
  consentType      String   // "marketing" o "newsletter"
  accepted         Boolean
  ipHash           String
  userAgentHash    String
  legalTextVersion String
  createdAt        DateTime @default(now())

  @@index([email])
}

model Notification {
  id          String    @id @default(uuid())
  type        String    // ej. "order_created", "ticket_created", "email_error", etc.
  title       String
  message     String
  severity    String    // "info", "success", "warning", "error", "critical"
  status      String    // "unread", "read", "archived"
  module      String    // "orders", "paypal", "printful", "email", "support", "waitlist", "automations", "backups", "sentry"
  entityType  String?   // ej. "Order", "SupportTicket", "DropWaitlist"
  entityId    String?   // ID de la entidad relacionada
  actionUrl   String?   // URL relativa para redirección directa (ej. "/admin/orders/AA-10001")
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  metadata    Json?     // Metadatos adicionales (ej. { count: 5, errorDetails: "..." })

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}


